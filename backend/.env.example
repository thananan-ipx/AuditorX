# Local PostgreSQL published by the root Docker Compose stack.
DATABASE_URL=postgresql://auditorx_api:auditorx-local-api@127.0.0.1:5433/auditorx?sslmode=disable
PORT=8080
REPOSITORY_STORAGE=postgres
# Enable only after a separately configured scan worker is ready.
SCAN_QUEUE_ENABLED=false
PREDICTION_SERVICE_URL=http://127.0.0.1:8090
# Local workstation only: repository writers can scan the mounted source root.
LOCAL_SCAN_ENABLED=false
# API-only: full host path corresponding to the worker root; permits pasting host paths.
LOCAL_SCAN_HOST_ROOT=
# Worker-only; Docker Compose supplies /scan-sources.
LOCAL_SCAN_ROOT=
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Optional GitHub App. Configure all five values to enable GitHub login/import.
# Contents: read-only; Metadata: read-only; Account email addresses: read-only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_APP_SLUG=
# Base64 of 32 random bytes; provide the same key to the scan worker.
GITHUB_TOKEN_ENCRYPTION_KEY=
