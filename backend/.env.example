# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.yvyatbyobztvshhueozq.supabase.co:5432/postgres?sslmode=require
PORT=8080
# Opt in only after applying the reviewed migration to your intended database.
REPOSITORY_STORAGE=prototype
# Enable only after the scan migration and a separately configured worker are ready.
SCAN_QUEUE_ENABLED=false
# Worker reads these from its process environment, not this .env file:
# SCAN_WORKER_DATABASE_URL=postgresql://DEDICATED_WORKER_LOGIN:.../postgres?sslmode=require
# SEMGREP_EXECUTABLE=/absolute/path/to/semgrep
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# Set to a shared parent domain in production when web and API use different subdomains, e.g. .example.com
COOKIE_DOMAIN=
